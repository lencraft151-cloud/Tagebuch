{
  "name": "urlaubs-tagebuch",
  "version": "1.0.0",
  "private": true,
  "description": "Persönliches digitales Reisearchiv – statische Website für GitHub Pages mit GitHub-basiertem Admin-Bereich.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node src/dev-server.mjs",
    "preview": "node src/build.mjs && node src/dev-server.mjs --no-watch",
    "check": "node src/check-content.mjs",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\""
  },
  "license": "MIT"
}
